# Remote Supabase (recommended — no local Docker)
SUPABASE_PROJECT_REF=your_project_ref
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
# Optional: apply migrations with `pnpm database#push:remote` (Dashboard → Database → Connection string → URI)
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Used by OAuth/magic-link redirects, canonical URLs, sitemap, and Open Graph (see apps/web/src/utils/helpers.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000/

# Stripe (test mode — Prompt Market sandbox)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# SaaS Launch Kit — created in Stripe Dashboard or via Stripe MCP
STRIPE_PRICE_SAAS_LAUNCH_KIT=price_1UErDqDapp6FrrVs8UAvsek3
# Portfolio Launch Kit — separate Stripe Price for portfolio-launch-kit checkout
STRIPE_PRICE_PORTFOLIO_LAUNCH_KIT=price_...
